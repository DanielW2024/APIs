{
  "name": "k6-qualification-test",
  "version": "1.0.0",
  "description": "Pruebas de rendimiento para API de Qualification",
  "main": "src/test.js",
  "scripts": {
    "test:smoke": "k6 run scripts/smoke-test.js",
    "test:load": "k6 run scripts/load-test.js",
    "test:stress": "k6 run scripts/stress-test.js",
    "test:spike": "k6 run scripts/spike-test.js",
    "test:all": "npm run test:smoke && npm run test:load && npm run test:stress",
    "report": "k6 run scripts/load-test.js --out json=reports/results.json"
  },
  "devDependencies": {
    "k6": "^0.0.0"
  },
  "keywords": [
    "k6",
    "performance",
    "load-testing",
    "api-testing"
  ],
  "author": "Daniel Espiritu",
  "license": "MIT",
  "dependencies": {
    "puppeteer": "^24.43.1"
  }
}
